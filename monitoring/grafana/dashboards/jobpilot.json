{
  "title": "JobPilot",
  "uid": "jobpilot",
  "editable": true,
  "panels": [
    {
      "title": "Applications per status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "jobpilot_applications_total", "legendFormat": "All applications" },
        { "expr": "jobpilot_interviews_total", "legendFormat": "Interviews" },
        { "expr": "jobpilot_offers_total", "legendFormat": "Offers" },
        { "expr": "jobpilot_rejected_total", "legendFormat": "Rejected" }
      ]
    },
    {
      "title": "Scraped jobs",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "jobpilot_jobs_total", "legendFormat": "Jobs" }
      ]
    },
    {
      "title": "Status funnel",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "jobpilot_applications_status{status=~\"applied|viewed|responded|interview|offer|rejected\"}", "legendFormat": "{{status}}" }
      ]
    },
    {
      "title": "Responses & resumes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "jobpilot_responses_total", "legendFormat": "Responses" },
        { "expr": "jobpilot_resumes_total", "legendFormat": "Resumes" }
      ]
    }
  ],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1
}
