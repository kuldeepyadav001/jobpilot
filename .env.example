# Database
DB_USER=jobpilot
DB_PASSWORD=changeme_strong_password
DB_NAME=jobpilot_db

# App
ENVIRONMENT=development
SECRET_KEY=changeme_random_secret_key
# Used as the signature name on AI cover letters. Leave blank to auto-detect from resume.
CANDIDATE_NAME=

# Email (Gmail App Password only)
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Ollama
# In-network URL for the docker compose stack. Do NOT use host.docker.internal here.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b

# APPLICATION GATE — how the "one click, everything done" button behaves.
#   REAL     = the manual run button actually submits applications (email/portal).
#   dry_run  = the manual run does everything EXCEPT the final submit (safe preview).
# APPLY_MODE controls whether the manual 'Run Pipeline' REALLY submits.
#   dry_run -> does everything EXCEPT the final submit (safe; jobs show 'Applied'
#              in your dashboard but are NOT actually sent). This is why jobs look
#              applied on the portal that isn't.
#   real    -> actually submits to Internshala (needs a valid INTERNSHALA_COOKIE)
#              and sends cover-letter emails (needs SMTP set below).
# SET TO real ONLY when you're logged in with valid cookies and want real sends.
APPLY_MODE=real

# RAISE THESE to MAXIMISE applications as a student who can't be too choosy:
#   APPLY_TARGET_COUNT = how many top-scoring jobs per cycle.
#   DAILY_APPLY_CAP    = max real sends per portal per day (rate-limit safety).
APPLY_TARGET_COUNT=10
DAILY_APPLY_CAP=25
# Scheduled 6-hourly run applies too? Leave FALSE so only your button-click ever applies.
AUTO_APPLY=false

# Scraping
# match_score_threshold is now a soft FLOOR. Leave at 0 to disable it and apply to
# the top-N scoring jobs instead (recommended while scores are uncalibrated).
MATCH_SCORE_THRESHOLD=0
SCHEDULER_INTERVAL_HOURS=6
# How many highest-scoring unapplied jobs to target per apply cycle.
APPLY_TARGET_COUNT=10
# Where to scrape / how many cards per portal per keyword.
SEARCH_LOCATION=remote
MAX_PER_PORTAL=5
# Which Internshala sections to scrape. Keep them fully separate:
#   jobs           -> only  /jobs/{kw}-jobs          (annual salary)
#   internships    -> only /internships/{kw}-internships (monthly stipend)
#   jobs,internships (default) -> both, tagged job_type separately.
# Set only ONE to make the Jobs/Internships feed toggle exactly mirror what's scraped.
SCRAPE_TYPES=jobs,internships
# "GOOD PAY" preference: skip jobs whose KNOWN salary is below this (yearly).
# 0 = off. Unknown-salary jobs are kept but ranked below known-paid ones.
MIN_SALARY=0
# Broad keywords (cast a wide net across your resume roles). Add more for more volume.
SEARCH_KEYWORDS=python developer, backend developer, full stack developer, java developer, frontend developer, react developer, machine learning, ai engineer, devops engineer, cloud engineer

# JOB CLEANUP: prune never-applied jobs older than JOB_RETENTION_DAYS, weekly.
JOB_CLEANUP_ENABLED=true
JOB_RETENTION_DAYS=30

# Portals
INTERNSHALA_COOKIE=
NAUKRI_COOKIE=